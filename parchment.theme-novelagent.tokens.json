      "panel":             { "$value": "#F4F1E9", "$type": "color" },
      "line":              { "$value": "#E6E1D5", "$type": "color" },
      "lineSoft":          { "$value": "#F0EDE3", "$type": "color" },
      "ink":               { "$value": "#211F1B", "$type": "color" },
      "ink2":              { "$value": "#4A473E", "$type": "color" },
