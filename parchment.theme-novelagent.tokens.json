{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NovelAgent — Muted Navy variant for Parchment 3.2. Commercial / creator-tool identity with warm neutral canvas + ink navy accent.",
  "$parent": "parchment.v3.tokens.json",
  "meta": {
    "theme": { "$value": "novelagent", "$type": "string" },
    "identity": { "$value": "NovelAgent — 墨蓝·商业型", "$type": "string" },
