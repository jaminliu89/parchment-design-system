      "textTertiary":   { "$value": "{color.primitive.ink3}" },
      "textPlaceholder":{ "$value": "{color.primitive.ink4}" },
      "interactive":    { "$value": "{color.primitive.signal}" },
      "interactiveHover":{ "$value": "{color.primitive.ink}" },
      "signal":         { "$value": "{color.primitive.signal}" },
      "signalSoft":     { "$value": "{color.primitive.signalSoft}" },
      "success":        { "$value": "{color.primitive.success}" },
      "warning":        { "$value": "{color.primitive.warning}" },
      "warningSoft":    { "$value": "{color.primitive.warningSoft}" },
      "error":          { "$value": "{color.primitive.error}" }
    }
  },
  "typography": {
    "ui":        { "$value": "'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
    "editorial": { "$value": "'Noto Serif SC', 'Source Serif 4', 'Instrument Serif', Georgia, serif" },
    "mono":      { "$value": "ui-monospace, 'SF Mono', 'Cascadia Code', monospace" }
