      "ink4":              { "$value": "#A8A395", "$type": "color" },
      "signal":            { "$value": "#2E3A52", "$type": "color", "$description": "墨蓝 navy — replaces Parchment warm signal" },
      "signalSoft":        { "$value": "#EDEFF3", "$type": "color" },
      "success":           { "$value": "#7A9B7E", "$type": "color" },
